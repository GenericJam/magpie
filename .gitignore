/_build/
/deps/
/doc/
/.fetch
*.ez
*.beam
*.o
*.so
*.a
erl_crash.dump

# Machine-local Mob config overrides (mob.exs itself is project config — commit it)
mob.local.exs

# Signing secrets — NEVER commit
android/keystore.properties
android/*.keystore

# Native build caches / outputs
android/app/src/main/assets/otp.zip
android/local.properties
android/.gradle/
android/app/build/
android/app/.cxx/
ios/zig-out/
ios/.zig-cache/
**/.zig-cache/
_build/mob_release/
# Swift module side outputs `mix mob.release` drops in the project root
/*.swiftmodule
/*.swiftdoc
/*.swiftsourceinfo
/*.abi.json

# Regenerated by mix mob.release / mix mob.provision on every run
ios/release_device.sh
ios/Provision.xcodeproj/
ios/MobProvision.swift
xcuserdata/

# macOS
.DS_Store

# Rewritten by mob_dev on every build (runtime plugin manifest). The static-NIF
# driver tables are tracked: mob_dev only refreshes tables that exist, so a
# clone without them would link magpie_audio but never register it
# (:nif_not_loaded on the phone). Regenerate with `mix mob.regen_driver_tab`.
priv/generated/*
!priv/generated/driver_tab_android.zig
!priv/generated/driver_tab_ios.zig
