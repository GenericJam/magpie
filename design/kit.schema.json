{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magpie/kit.schema.json",
  "title": "Magpie kit",
  "description": "A kit: up to 4 banks of 16 pads, each pointing at a sample in the library, plus step patterns.",
  "type": "object",
  "required": ["format", "id", "name", "tempo", "banks"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "magpie.kit/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "name": { "type": "string", "maxLength": 32 },
    "tempo": { "type": "number", "minimum": 40, "maximum": 240 },
    "swing": { "type": "number", "minimum": 0.5, "maximum": 0.75, "default": 0.5 },
    "snap": { "type": "boolean", "default": true },
    "midi": {
      "type": "object",
      "properties": {
        "in_channel": { "oneOf": [{ "const": "all" }, { "type": "integer", "minimum": 1, "maximum": 16 }], "default": "all" },
        "clock": { "enum": ["internal", "follow", "send"], "default": "internal" }
      }
    },
    "banks": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "pads"],
        "properties": {
          "id": { "enum": ["A", "B", "C", "D"] },
          "pads": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/pad" } }
        }
      }
    },
    "patterns": { "type": "array", "items": { "$ref": "#/$defs/pattern" } },
    "meta": { "type": "object" }
  },
  "$defs": {
    "pad": {
      "type": "object",
      "required": ["slot"],
      "properties": {
        "slot": { "type": "integer", "minimum": 0, "maximum": 15, "description": "0 = top-left in landscape 8×2 order (row-major)." },
        "name": { "type": "string", "maxLength": 12 },
        "color": { "enum": ["coral", "amber", "lime", "teal", "sky", "violet", "pink", "cream"] },
        "sample": {
          "type": "object",
          "required": ["id"],
          "description": "Non-destructive region of a library sample.",
          "properties": {
            "id": { "type": "string", "description": "Library sample id (content hash)." },
            "start": { "type": "number", "minimum": 0, "description": "seconds" },
            "end": { "type": "number", "minimum": 0, "description": "seconds; omitted = to the end" },
            "fade_in_ms": { "type": "number", "minimum": 0, "default": 0 },
            "fade_out_ms": { "type": "number", "minimum": 0, "default": 0 },
            "gain_db": { "type": "number", "minimum": -48, "maximum": 12, "default": 0 },
            "pitch_st": { "type": "number", "minimum": -24, "maximum": 24, "default": 0 },
            "reverse": { "type": "boolean", "default": false }
          }
        },
        "mode": { "enum": ["one_shot", "gate", "loop", "toggle", "keys"], "default": "one_shot" },
        "choke": { "type": "integer", "minimum": 0, "maximum": 3, "default": 0, "description": "0 = none" },
        "velocity": { "enum": ["position", "fixed"], "default": "position" },
        "fixed_velocity": { "type": "integer", "minimum": 1, "maximum": 127, "default": 100 },
        "midi_note": { "type": "integer", "minimum": 0, "maximum": 127, "description": "Note that triggers this pad from MIDI in, and that it sends out. keys mode: the root note." }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["id", "bank", "length", "lanes"],
      "properties": {
        "id": { "type": "string", "maxLength": 8 },
        "bank": { "enum": ["A", "B", "C", "D"] },
        "length": { "enum": [16, 32] },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slot", "steps"],
            "properties": {
              "slot": { "type": "integer", "minimum": 0, "maximum": 15 },
              "mute": { "type": "boolean", "default": false },
              "steps": {
                "type": "array",
                "description": "Only steps that play. tick = offset from the step start at 96 PPQN (0 when snapped).",
                "items": {
                  "type": "object",
                  "required": ["step", "vel"],
                  "properties": {
                    "step": { "type": "integer", "minimum": 0, "maximum": 31 },
                    "vel": { "type": "integer", "minimum": 1, "maximum": 127 },
                    "tick": { "type": "integer", "minimum": -12, "maximum": 12, "default": 0 },
                    "note": { "type": "integer", "minimum": 0, "maximum": 127, "description": "keys-mode pads only" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
